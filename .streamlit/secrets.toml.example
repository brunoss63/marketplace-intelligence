MI_ENV = "development"
SUPABASE_DEV_URL = "https://<dev-project-id>.supabase.co"
SUPABASE_DEV_ANON_KEY = "COLE_A_CHAVE_PUBLISHABLE_DO_DEV_AQUI"

# Configure somente depois de criar a aplicação de desenvolvimento do
# Mercado Livre. Gere uma chave com Fernet.generate_key() e guarde a mesma
# chave nos secrets do ambiente DEV hospedado; não a versione nem a rotacione
# sem recriptografar os tokens persistidos.
# MERCADOLIVRE_DEV_CLIENT_ID = "APP_ID"
# MERCADOLIVRE_DEV_CLIENT_SECRET = "SECRET_KEY"
# MERCADOLIVRE_DEV_REDIRECT_URI = "https://marketplace-intelligence-dev.streamlit.app/"
# MERCADOLIVRE_DEV_TOKEN_ENCRYPTION_KEY = "CHAVE_FERNET_BASE64"

# Na hospedagem de produção, use MI_ENV = "production" e:
# SUPABASE_PROD_URL = "https://<prod-project-id>.supabase.co"
# SUPABASE_PROD_ANON_KEY = "COLE_A_CHAVE_PUBLISHABLE_DA_PRODUCAO_AQUI"
